# Copy to backend/.env and fill in. Never commit the real .env.

# PostgreSQL connection (database must exist: CREATE DATABASE online_exam_system;)
DATABASE_URL=postgresql://postgres:password@localhost:5432/online_exam_system

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Optional: comma-separated frontend origins allowed to call the API
# CORS_ORIGINS=http://localhost:3000,https://exams.example.com

# Optional: DEBUG, INFO (default), WARNING or ERROR. Logs are JSON lines on stdout.
# LOG_LEVEL=INFO

# Optional: "off" stops the API's background jobs (use cron: python -m app.jobs finalize-attempts)
# BACKGROUND_JOBS=on

# Optional: "off" disables the sign-in/signup/join rate limits (load tests only)
# RATE_LIMITS=on

# The frontend's public URL, used in links inside emails
# APP_URL=http://localhost:3000

# Email. "console" (default) writes emails to EMAIL_OUTBOX_DIR instead of sending them.
# For real email use "smtp" with any provider's SMTP credentials.
# EMAIL_BACKEND=console
# EMAIL_OUTBOX_DIR=.outbox
# EMAIL_FROM=TestKori <no-reply@your-domain.com>
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
